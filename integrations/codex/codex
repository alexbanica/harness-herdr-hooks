#!/usr/bin/env python3
"""Profile-owned Codex command adapter installed beside adapter.json."""
import json
import os
from pathlib import Path
import stat
import sys


def fail():
    raise SystemExit("harness-herdr-hooks: managed Codex adapter metadata unavailable")

try:
    metadata = Path(__file__).with_name("adapter.json")
    info = metadata.lstat()
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
            or stat.S_IMODE(info.st_mode) & 0o077):
        fail()
    config = json.loads(metadata.read_text(encoding="utf-8"))
    if set(config) != {"schema", "source_root", "native_executable", "config_root"} or config["schema"] != 1:
        fail()
    source = Path(config["source_root"])
    if not source.is_absolute():
        fail()
    sys.path.insert(0, str(source / "src"))
    from harness_herdr_hooks.launch import main
    raise SystemExit(main(shim_path=Path(__file__)))
except (OSError, ValueError, KeyError, TypeError):
    fail()
