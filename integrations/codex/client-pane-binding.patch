+
+fn initiating_message_matches(entries: &[ThreadItemEntry], turn: &str, client_id: &str) -> bool {
+    entries.iter().find_map(|entry| match &entry.item.payload {
+        ThreadItemPayload::UserMessage {
+            client_id: item_id, ..
+        } => Some(entry.turn_id == turn && item_id.as_deref() == Some(client_id)),
+        _ => None,
+    }) == Some(true)
+}
