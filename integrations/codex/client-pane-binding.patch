+#[cfg(test)]
+#[test]
+fn herdr_display_binding_does_not_attribute_a_steer_to_its_sender() {
+    fn message(turn: &str, client_id: &str) -> ThreadItemEntry {
+        ThreadItemEntry {
+            turn_id: turn.to_string(),
+            item: ThreadItem::untimed(ThreadItemPayload::UserMessage {
+                id: client_id.to_string(),
+                client_id: Some(client_id.to_string()),
+                content: Vec::new(),
+            }),
+            output_deferred: false,
+            started_at_ms: None,
+            completed_at_ms: None,
+        }
+    }
+    let entries = [message("turn", "initial"), message("turn", "steer")];
+    assert!(initiating_message_matches(&entries, "turn", "initial"));
+    assert!(!initiating_message_matches(&entries, "turn", "steer"));
+    assert!(!initiating_message_matches(
+        &entries,
+        "different",
+        "initial"
+    ));
+    assert!(!initiating_message_matches(&[], "turn", "initial"));
+}
