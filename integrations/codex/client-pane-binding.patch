+            turn_id: Some(context.turn.clone()),
+            cursor: None,
+            limit: Some(8),
+            sort_direction: Some(SortDirection::Asc),
+            defer_output: None,
+        },
+    });
+    let Ok(Ok(items)) = tokio::time::timeout(std::time::Duration::from_millis(500), query).await
+    else {
+        return false;
+    };
+    // The server's StartResponse shape is also used for steer. Only the first
+    // user item on the returned turn distinguishes the exact initiating input.
