+async fn corroborates_start_origin(
+    handle: &AppServerRequestHandle,
+    context: &crate::app::herdr_display_binding::CreationContext,
+) -> bool {
+    let query = handle.request_typed::<ThreadItemsListResponse>(ClientRequest::ThreadItemsList {
+        request_id: RequestId::String(format!("herdr-origin-{}", Uuid::new_v4())),
+        params: ThreadItemsListParams {
