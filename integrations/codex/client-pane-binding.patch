diff --git a/codex-rs/tui/src/app/herdr_display_binding.rs b/codex-rs/tui/src/app/herdr_display_binding.rs
new file mode 100644
index 0000000000000000000000000000000000000000..06e48fe7fa965447877040e637560fb2f4bf472d
--- /dev/null
+++ b/codex-rs/tui/src/app/herdr_display_binding.rs
@@ -0,0 +1,469 @@
+//! Opt-in reporting of the primary conversation currently displayed by this TUI.
+//!
+//! The helper is supplied by the managed Herdr profile. With no helper configured this module is
+//! inert, preserving the ordinary Codex launch path.
+use color_eyre::eyre::{Result, bail, eyre};
+use serde_json::{Value, json};
+use std::io::{Read, Write};
+#[cfg(unix)]
+use std::os::fd::AsRawFd;
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+const HELPER_ENV: &str = "HARNESS_HERDR_CLIENT_REPORTER";
+const MAX_LINE: usize = 4096;
+const NONCE_ENV: &str = "HARNESS_HERDR_CLIENT_NONCE";
+
+#[derive(Clone)]
+struct RevocationTicket {
+    helper: std::path::PathBuf,
+    nonce: String,
+    recovered: bool,
+}
+
+struct Reporter {
+    child: Child,
+    ticket: RevocationTicket,
+    input: ChildStdin,
+    output: ChildStdout,
+    sequence: u64,
+    active_thread: Option<String>,
+    active_sequence: Option<u64>,
+    own_turn: Option<(String, String)>,
+}
+
+enum State {
+    Pending { recovered: bool },
+    Disabled,
+    Connected(Reporter),
+    Blocked(RevocationTicket),
+}
+
+static REPORTER: OnceLock<Mutex<State>> = OnceLock::new();
+
+fn state() -> &'static Mutex<State> {
+    REPORTER.get_or_init(|| Mutex::new(State::Pending { recovered: false }))
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct CreationContext {
+    pub(crate) parent: String,
+    pub(crate) turn: String,
+    pub(crate) client_message_id: String,
+    view_sequence: u64,
+}
+
+/// Revoke the prior view before a transition. Failure is surfaced to the caller so a managed
+/// transition cannot silently retain stale placement authority.
+pub(super) fn clear() -> Result<()> {
+    let result = with_reporter(false, |reporter| {
+        if reporter.active_sequence.is_some() {
+            reporter.request("clear", Value::Null, None, None)?;
+            reporter.active_thread = None;
+            reporter.active_sequence = None;
+            reporter.own_turn = None;
+        }
+        Ok(())
+    });
+    if result.is_err() {
+        verify_revocation()
+    } else {
+        result
+    }
+}
+
+fn verify_revocation() -> Result<()> {
+    let mut state = state()
+        .lock()
+        .map_err(|_| eyre!("reporter lock poisoned"))?;
+    let State::Blocked(ticket) = &*state else {
+        bail!("Herdr client display revocation could not be confirmed");
+    };
+    let mut probe = spawn_helper(ticket, "verify-revoked")?;
+    let deadline = Instant::now() + Duration::from_secs(6);
+    while Instant::now() < deadline {
+        if let Some(status) = probe.try_wait()? {
+            if status.success() {
+                *state = State::Pending { recovered: true };
+                return Ok(());
+            }
+            bail!("Herdr client display revocation could not be confirmed");
+        }
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    let _ = probe.kill();
+    let _ = probe.wait();
+    bail!("Herdr client display revocation verification timed out");
+}
+
+/// Publish a successfully adopted primary view with the transition recorded by the caller.
+pub(super) fn active(thread_id: &str, source: &str) -> Result<()> {
+    if !matches!(source, "startup" | "resume" | "fork") {
+        bail!("unsupported Herdr display binding source");
+    }
+    let id = uuid::Uuid::parse_str(thread_id)?;
+    with_reporter(true, |reporter| {
+        let id = id.to_string();
+        reporter.request("active", json!(id), Some(source), None)?;
+        reporter.active_thread = Some(id);
+        reporter.active_sequence = Some(reporter.sequence);
+        reporter.own_turn = None;
+        Ok(())
+    })
+}
+
+/// Remember only the server-confirmed start response for the exact acknowledged primary view.
+pub(crate) fn user_turn_started(thread_id: &str, turn_id: &str, client_message_id: &str) {
+    let _ = with_reporter(false, |reporter| {
+        if reporter.active_thread.as_deref() == Some(thread_id)
+            && reporter.active_sequence.is_some()
+            && !turn_id.is_empty()
+            && turn_id.len() <= 128
+        {
+            reporter.own_turn = Some((turn_id.to_string(), client_message_id.to_string()));
+        }
+        Ok(())
+    });
+}
+
+pub(crate) fn creation_context(parent: &str, turn: &str) -> Option<CreationContext> {
+    let state = state().lock().ok()?;
+    let State::Connected(reporter) = &*state else {
+        return None;
+    };
+    reporter.creation_context(parent, turn)
+}
+
+pub(crate) fn created(context: &CreationContext, child: &str) {
+    let _ = with_reporter(false, |reporter| {
+        let child = uuid::Uuid::parse_str(child)?.to_string();
+        if reporter
+            .creation_context(&context.parent, &context.turn)
+            .as_ref()
+            != Some(context)
+        {
+            return Ok(());
+        }
+        reporter.request(
+            "created",
+            json!(context.parent),
+            None,
+            Some(json!({"child_id": child, "turn_id": context.turn, "view_sequence": context.view_sequence})),
+        )
+    });
+}
+
+pub(super) fn shutdown() {
+    if std::env::var_os(HELPER_ENV).is_none() {
+        return;
+    }
+    let _ = with_reporter(false, |reporter| {
+        reporter.request("clear", Value::Null, None, None)
+    });
+    if let Ok(mut state) = state().lock() {
+        *state = State::Disabled;
+    }
+}
+
+fn with_reporter(start: bool, request: impl FnOnce(&mut Reporter) -> Result<()>) -> Result<()> {
+    let Some(helper) = std::env::var_os(HELPER_ENV) else {
+        return Ok(());
+    };
+    let mut state = state()
+        .lock()
+        .map_err(|_| eyre!("reporter lock poisoned"))?;
+    if let State::Pending { recovered } = *state
+        && start
+    {
+        let ticket = RevocationTicket {
+            helper: std::path::PathBuf::from(helper),
+            nonce: uuid::Uuid::new_v4().to_string(),
+            recovered,
+        };
+        match spawn_reporter(ticket) {
+            Ok(reporter) => *state = State::Connected(reporter),
+            Err(error) => {
+                *state = State::Disabled;
+                return Err(error);
+            }
+        }
+    }
+    match &mut *state {
+        State::Connected(reporter) => {
+            let was_active = reporter.active_sequence.is_some();
+            let result = request(reporter);
+            if result.is_err() {
+                *state = if was_active {
+                    State::Blocked(reporter.ticket.clone())
+                } else {
+                    State::Disabled
+                };
+            }
+            result
+        }
+        State::Blocked(_) => bail!("Herdr client display revocation could not be confirmed"),
+        State::Pending { .. } | State::Disabled => Ok(()),
+    }
+}
+
+#[cfg(unix)]
+fn spawn_helper(ticket: &RevocationTicket, mode: &str) -> Result<Child> {
+    use std::os::fd::FromRawFd;
+    use std::os::unix::process::CommandExt;
+
+    if !ticket.helper.is_absolute() || !std::io::IsTerminal::is_terminal(&std::io::stdin()) {
+        bail!("Herdr reporter requires an absolute helper and the client terminal");
+    }
+    // Hold a duplicate of the terminal already used by the TUI before Command redirects fd 0.
+    let tty = unsafe { libc::fcntl(std::io::stdin().as_raw_fd(), libc::F_DUPFD_CLOEXEC, 4) };
+    if tty < 0 {
+        return Err(std::io::Error::last_os_error().into());
+    }
+    let terminal = unsafe { std::os::fd::OwnedFd::from_raw_fd(tty) };
+    let mut command = Command::new(&ticket.helper);
+    command
+        .arg("client-report")
+        .env(NONCE_ENV, &ticket.nonce)
+        .stderr(Stdio::null());
+    if ticket.recovered {
+        command
+            .env_remove("HARNESS_HERDR_CHILD_CLAIM")
+            .env_remove("HARNESS_HERDR_DISPLAY");
+    }
+    if mode == "verify-revoked" {
+        command.arg(mode).stdin(Stdio::null()).stdout(Stdio::null());
+    } else {
+        command.stdin(Stdio::piped()).stdout(Stdio::piped());
+    }
+    unsafe {
+        command.pre_exec(move || {
+            if libc::dup2(terminal.as_raw_fd(), 3) < 0 {
+                return Err(std::io::Error::last_os_error());
+            }
+            Ok(())
+        });
+    }
+    Ok(command.spawn()?)
+}
+
+#[cfg(not(unix))]
+fn spawn_helper(_ticket: &RevocationTicket, _mode: &str) -> Result<Child> {
+    bail!("Herdr client reporter requires a Unix terminal")
+}
+
+fn spawn_reporter(ticket: RevocationTicket) -> Result<Reporter> {
+    let mut child = spawn_helper(&ticket, "report")?;
+    let input = child
+        .stdin
+        .take()
+        .ok_or_else(|| eyre!("reporter stdin unavailable"))?;
+    let output = child
+        .stdout
+        .take()
+        .ok_or_else(|| eyre!("reporter stdout unavailable"))?;
+    Ok(Reporter {
+        child,
+        ticket,
+        input,
+        output,
+        sequence: 0,
+        active_thread: None,
+        active_sequence: None,
+        own_turn: None,
+    })
+}
+
+impl Drop for Reporter {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+#[cfg(unix)]
+fn wait_for_output(output: &ChildStdout, deadline: Instant) -> Result<()> {
+    let mut descriptor = libc::pollfd {
+        fd: output.as_raw_fd(),
+        events: libc::POLLIN,
+        revents: 0,
+    };
+    let timeout = deadline
+        .saturating_duration_since(Instant::now())
+        .as_millis() as i32;
+    if timeout <= 0
+        || unsafe { libc::poll(&mut descriptor, 1, timeout) } <= 0
+        || descriptor.revents & libc::POLLIN == 0
+    {
+        bail!("Herdr reporter acknowledgement timed out or disconnected");
+    }
+    Ok(())
+}
+
+#[cfg(not(unix))]
+fn wait_for_output(_output: &ChildStdout, _deadline: Instant) -> Result<()> {
+    bail!("Herdr client reporter requires a Unix terminal")
+}
+
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Acknowledgement {
+    version: u8,
+    sequence: u64,
+    status: String,
+}
+
+fn check_acknowledgement(bytes: &[u8], sequence: u64) -> Result<()> {
+    let reply: Acknowledgement = serde_json::from_slice(bytes)?;
+    if reply.version != 1 || reply.sequence != sequence || reply.status != "ok" {
+        bail!("Herdr reporter rejected or mismatched a display report");
+    }
+    Ok(())
+}
+
+fn bound_creation(
+    active: Option<&str>,
+    own_turn: Option<(&str, &str)>,
+    sequence: Option<u64>,
+    requested_parent: &str,
+    requested_turn: &str,
+) -> Option<CreationContext> {
+    let (owned_id, client_message_id) = own_turn?;
+    if active != Some(requested_parent) || owned_id != requested_turn {
+        return None;
+    }
+    Some(CreationContext {
+        parent: requested_parent.to_owned(),
+        turn: requested_turn.to_owned(),
+        client_message_id: client_message_id.to_owned(),
+        view_sequence: sequence?,
+    })
+}
+
+impl Reporter {
+    fn creation_context(&self, parent: &str, turn: &str) -> Option<CreationContext> {
+        bound_creation(
+            self.active_thread.as_deref(),
+            self.own_turn
+                .as_ref()
+                .map(|(turn, message)| (turn.as_str(), message.as_str())),
+            self.active_sequence,
+            parent,
+            turn,
+        )
+    }
+
+    fn request(
+        &mut self,
+        event: &str,
+        thread_id: Value,
+        source: Option<&str>,
+        fields: Option<Value>,
+    ) -> Result<()> {
+        self.sequence = self
+            .sequence
+            .checked_add(1)
+            .ok_or_else(|| eyre!("report sequence exhausted"))?;
+        let mut message =
+            json!({"version":1,"sequence":self.sequence,"event":event,"thread_id":thread_id});
+        if let Some(source) = source {
+            message["source"] = json!(source);
+        }
+        if let Some(fields) = fields {
+            if let Some(object) = fields.as_object() {
+                for (key, value) in object {
+                    message[key] = value.clone();
+                }
+            }
+        }
+        let mut bytes = serde_json::to_vec(&message)?;
+        if bytes.len() + 1 > MAX_LINE {
+            bail!("Herdr report exceeds line limit");
+        }
+        bytes.push(b'\n');
+        self.input.write_all(&bytes)?;
+        self.input.flush()?;
+        let deadline = Instant::now() + Duration::from_secs(6);
+        let mut reply = Vec::new();
+        while reply.len() < MAX_LINE {
+            wait_for_output(&self.output, deadline)?;
+            let mut byte = [0_u8];
+            if self.output.read(&mut byte)? == 0 {
+                bail!("Herdr reporter closed");
+            }
+            if byte[0] == b'\n' {
+                break;
+            }
+            reply.push(byte[0]);
+        }
+        if reply.len() == MAX_LINE {
+            bail!("Herdr reporter exceeded line limit");
+        }
+        check_acknowledgement(&reply, self.sequence)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn rejects_invalid_thread_ids() {
+        assert!(active("not-a-uuid", "startup").is_err());
+    }
+
+    #[test]
+    fn acknowledgements_require_exact_sequence_shape_and_success() {
+        assert!(check_acknowledgement(br#"{"version":1,"sequence":4,"status":"ok"}"#, 4).is_ok());
+        for invalid in [
+            br#"{"version":1,"sequence":3,"status":"ok"}"#.as_slice(),
+            br#"{"version":1,"sequence":4,"status":"rejected"}"#,
+            br#"{"version":1,"sequence":4,"status":"ok","extra":1}"#,
+            br#"{"version":1,"sequence":2,"sequence":4,"status":"ok"}"#,
+        ] {
+            assert!(check_acknowledgement(invalid, 4).is_err());
+        }
+    }
+
+    #[test]
+    fn creation_requires_own_turn_and_current_view_generation() {
+        let first = bound_creation(
+            Some("parent"),
+            Some(("own", "message")),
+            Some(1),
+            "parent",
+            "own",
+        )
+        .unwrap();
+        assert!(bound_creation(Some("parent"), None, Some(1), "parent", "own").is_none());
+        assert!(
+            bound_creation(
+                Some("parent"),
+                Some(("other", "message")),
+                Some(1),
+                "parent",
+                "own"
+            )
+            .is_none()
+        );
+        assert!(
+            bound_creation(
+                Some("parent"),
+                Some(("own", "message")),
+                None,
+                "parent",
+                "own"
+            )
+            .is_none()
+        );
+        assert_ne!(
+            Some(first),
+            bound_creation(
+                Some("parent"),
+                Some(("own", "message")),
+                Some(2),
+                "parent",
+                "own"
+            )
+        );
+    }
+}
