+    #[cfg(unix)]
+    fn herdr_client_endpoint_matches(&self) -> bool {
+        use std::os::unix::fs::{FileTypeExt, MetadataExt};
+
+        let (Some(expected), Some(instance)) = (
+            std::env::var_os("HARNESS_HERDR_CLIENT_ENDPOINT"),
+            std::env::var_os("HARNESS_HERDR_CLIENT_ENDPOINT_INSTANCE"),
+        ) else {
+            return false;
+        };
